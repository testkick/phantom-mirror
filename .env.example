# --- infrastructure ---
DATA_DIR=/data                 # mount a Railway volume here
ADMIN_TOKEN=change-me          # required to add/remove traders; leave empty to disable auth
DEMO_MODE=false                # true = simulated traders and prices, no network
POLL_SECONDS=20
HL_DEXS=                       # "" = main Hyperliquid perps. e.g. ",xyz" to add a HIP-3 dex (experimental)

# --- paper execution ---
STARTING_EQUITY=10000
FEE_BPS=9.5                    # 4.5 Hyperliquid taker + 5 Phantom builder fee
SLIPPAGE_BPS=2

# --- strategy A: 1:1 copy ---
COPY_ALLOC_USD=1000            # paper equity assigned to each trader
COPY_MAX_LEVERAGE=5            # cap per mirrored position
COPY_REBALANCE_THRESHOLD=0.10  # ignore size changes smaller than this
COPY_EXISTING=false            # true = also mirror positions already open when tracking starts
MIN_ACCOUNT_VALUE=1000

# --- strategy B: consensus ---
CONSENSUS_MIN_TRADERS=3
CONSENSUS_AGREEMENT=0.70
CONSENSUS_EXIT_MIN_TRADERS=2
CONSENSUS_EXIT_AGREEMENT=0.50
CONSENSUS_NOTIONAL_USD=1000
CONSENSUS_MAX_POSITIONS=10
CONSENSUS_INCLUDE_EXISTING=true

# --- strategy C: Solana spot copy ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # public RPC is heavily rate-limited; use a provider URL (e.g. Helius)
JUP_API_BASE=https://lite-api.jup.ag                 # or https://api.jup.ag with JUP_API_KEY
JUP_API_KEY=
SPOT_ALLOC_USD=1000            # paper equity assigned to each spot trader
SPOT_FEE_BPS=85                # swap fee per side; adjust to your venue
SPOT_SLIPPAGE_BPS=100          # memecoins: be pessimistic
SPOT_MAX_POSITION_PCT=0.25     # cap per mirrored token, as a share of SPOT_ALLOC_USD
SPOT_MIN_LIQUIDITY_USD=50000   # don't enter tokens thinner than this (Jupiter liquidity)
SPOT_PRICE_REFRESH_SECONDS=300 # how often to re-price bags that aren't trading
