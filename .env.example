# --- infrastructure ---
DATA_DIR=/data                 # mount a Railway volume here
ADMIN_TOKEN=change-me          # required to add/remove traders; leave empty to disable auth
DEMO_MODE=false                # true = simulated traders and prices, no network
POLL_SECONDS=20
HL_DEXS=                       # extra HIP-3 dexes to always read; each trader's dexes are also auto-discovered
HL_DEX_DISCOVER_SECONDS=1800   # how often to re-sweep all HIP-3 dexes per trader

# --- paper execution ---
STARTING_EQUITY=10000
FEE_BPS=9.5                    # 4.5 Hyperliquid taker + 5 Phantom builder fee
SLIPPAGE_BPS=2

# --- strategy A: 1:1 copy ---
COPY_ALLOC_USD=1000            # paper equity assigned to each trader
COPY_MAX_LEVERAGE=5            # cap per mirrored position
COPY_REBALANCE_THRESHOLD=0.10  # ignore size changes smaller than this
COPY_EXISTING=false            # true = also mirror positions already open when tracking starts
MIN_ACCOUNT_VALUE=1000

# --- strategy B: consensus ---
CONSENSUS_MIN_TRADERS=3
CONSENSUS_AGREEMENT=0.70
CONSENSUS_EXIT_MIN_TRADERS=2
CONSENSUS_EXIT_AGREEMENT=0.50
CONSENSUS_SIZING=equal_weight   # equal_weight: equity / max positions each; fixed: CONSENSUS_NOTIONAL_USD each
CONSENSUS_MAX_POSITIONS=30
CONSENSUS_REBALANCE_THRESHOLD=0.25  # resize a held position once it drifts 25% from target
CONSENSUS_NOTIONAL_USD=1000     # only used when CONSENSUS_SIZING=fixed
CONSENSUS_INCLUDE_EXISTING=true

# --- strategy C: Solana spot copy ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # public RPC is heavily rate-limited; use a provider URL (e.g. Helius)
SPOT_WALLETS_PER_POLL=         # default 4 on the public RPC, 50 otherwise; wallets are read round-robin
JUP_API_BASE=https://lite-api.jup.ag                 # or https://api.jup.ag with JUP_API_KEY
JUP_API_KEY=
SPOT_ALLOC_USD=1000            # paper equity assigned to each spot trader
SPOT_FEE_BPS=85                # swap fee per side; adjust to your venue
SPOT_SLIPPAGE_BPS=100          # memecoins: be pessimistic
SPOT_MAX_POSITION_PCT=0.25     # cap per mirrored token, as a share of SPOT_ALLOC_USD
SPOT_MIN_LIQUIDITY_USD=50000   # don't enter tokens thinner than this (Jupiter liquidity)
SPOT_PRICE_REFRESH_SECONDS=300 # how often to re-price bags that aren't trading

# --- suggested traders ---
SOLANATRACKER_API_KEY=         # needed for spot suggestions (data.solanatracker.io); perps needs nothing
DISCOVER_LIMIT=15
DISCOVER_MIN_ACCOUNT_USD=25000
DISCOVER_CACHE_SECONDS=1800

# --- dry run: real Jupiter quotes for every spot copy trade; nothing is signed or sent ---
DRYRUN_ENABLED=true
DRYRUN_SOL_WALLET=             # your PUBLIC Solana address, only to check SOL balance. Never a private key.
LIVE_MAX_TRADE_USD=100
LIVE_MAX_SLIPPAGE_BPS=300
LIVE_DAILY_LOSS_USD=100
LIVE_SOL_RESERVE=0.05

# --- automatic consensus group (Hyperliquid leaderboard, refreshed daily) ---
ROSTER_ENABLED=true
ROSTER_SIZE=25                 # top N by monthly profit become consensus voters
ROSTER_MIN_ACCOUNT_USD=100000
ROSTER_MAX_WEEKLY_TURNOVER=50  # weekly volume / account above this = market maker, excluded
ROSTER_DROP_DAYS=3             # grace before a member who fell out is dropped
ROSTER_REFRESH_HOURS=24
CONSENSUS_MIN_SHARE=0.15       # entry needs >= this share of the group (or CONSENSUS_MIN_TRADERS, whichever is more)
CONSENSUS_EXIT_MIN_SHARE=0.08  # hold while >= this share remain (or CONSENSUS_EXIT_MIN_TRADERS)
HL_CONCURRENCY=6               # Hyperliquid traders fetched in parallel
